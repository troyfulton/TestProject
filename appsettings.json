{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "RootPath": "FileData",
    "MaxFileSizeGB": 100,
    "AllowOverwrite": false,
    "ShowHiddenFiles": false,
    "StreamBufferKB": 64
  },
  "Browsing": {
    "DefaultPageSize": 100,
    "MaxPageSize": 500,
    "DefaultSort": "Name",
    "MaxFilesForSizeTotal": 2000
  },
  "Search": {
    "Enabled": true,
    "MaxResults": 500,
    "TimeoutSeconds": 15,
    "MaxConcurrentSearches": 4,
    "IncludeSubdirectories": true
  },
  "Uploads": {
    "Enabled": true,
    "MaxFileSizeGB": 100,
    "ChunkSizeMB": 32,
    "StreamBufferKB": 64,
    "MaxConcurrentUploads": 4,
    "MaxRetries": 5,
    "RetryInitialDelaySeconds": 2,
    "ResumeEnabled": true,
    "SessionExpirationHours": 72,
    "VerifyChunkChecksum": true,
    "VerifyFinalChecksum": false,
    "AllowOverwrite": false
  },
  "Features": {
    "EnableUpload": true,
    "EnableDownload": true,
    "EnableSearch": true,
    "EnableCreateFolder": true,
    "EnableDelete": true,
    "EnableMove": true,
    "EnableCopy": true,
    "EnableDialogMode": true
  },
  "Security": {
    "AllowAnonymousAccess": false
  }
}

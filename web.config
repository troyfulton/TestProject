<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Align with Kestrel/IIS MaxRequestBodySize for resumable chunk uploads (64 MB). -->
        <requestLimits maxAllowedContentLength="67108864" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
